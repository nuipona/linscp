<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="linuxscp" namespace="MarshSecurity.Policies.LinuxSCP.v1" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />

  <supportedOn>
    <definitions>
      <definition name="LinuxSCP_Supported_Windows10Plus" displayName="$(string.LinuxSCP_Supported_Windows10Plus)" />
    </definitions>
  </supportedOn>

  <categories>
    <category name="LinuxSCP" displayName="$(string.LinuxSCP_Category)" />
    <category name="LinuxSCP_Security" displayName="$(string.LinuxSCP_Security_Category)">
      <parentCategory ref="LinuxSCP" />
    </category>
    <category name="LinuxSCP_Defaults" displayName="$(string.LinuxSCP_Defaults_Category)">
      <parentCategory ref="LinuxSCP" />
    </category>
  </categories>

  <policies>
    <policy name="LinuxSCP_DisablePasswordStoring"
            class="Machine"
            displayName="$(string.LinuxSCP_DisablePasswordStoring)"
            explainText="$(string.LinuxSCP_DisablePasswordStoring_Help)"
            key="SOFTWARE\Wow6432Node\nuipona\LinuxSCP 2"
            valueName="DisablePasswordStoring">
      <parentCategory ref="LinuxSCP_Security" />
      <supportedOn ref="LinuxSCP_Supported_Windows10Plus" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>

    <policy name="LinuxSCP_DisableOpenEdit"
            class="Machine"
            displayName="$(string.LinuxSCP_DisableOpenEdit)"
            explainText="$(string.LinuxSCP_DisableOpenEdit_Help)"
            key="SOFTWARE\Wow6432Node\nuipona\LinuxSCP 2"
            valueName="DisableOpenEdit">
      <parentCategory ref="LinuxSCP_Security" />
      <supportedOn ref="LinuxSCP_Supported_Windows10Plus" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>

    <policy name="LinuxSCP_DisableAcceptingHostKeys"
            class="Machine"
            displayName="$(string.LinuxSCP_DisableAcceptingHostKeys)"
            explainText="$(string.LinuxSCP_DisableAcceptingHostKeys_Help)"
            key="SOFTWARE\Wow6432Node\nuipona\LinuxSCP 2"
            valueName="DisableAcceptingHostKeys">
      <parentCategory ref="LinuxSCP_Security" />
      <supportedOn ref="LinuxSCP_Supported_Windows10Plus" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>

    <policy name="LinuxSCP_ForceBanners"
            class="Machine"
            displayName="$(string.LinuxSCP_ForceBanners)"
            explainText="$(string.LinuxSCP_ForceBanners_Help)"
            key="SOFTWARE\Wow6432Node\nuipona\LinuxSCP 2"
            valueName="ForceBanners">
      <parentCategory ref="LinuxSCP_Security" />
      <supportedOn ref="LinuxSCP_Supported_Windows10Plus" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>

    <policy name="LinuxSCP_DefaultUpdatesPeriod"
            class="Machine"
            displayName="$(string.LinuxSCP_DefaultUpdatesPeriod)"
            explainText="$(string.LinuxSCP_DefaultUpdatesPeriod_Help)"
            presentation="$(presentation.LinuxSCP_DefaultUpdatesPeriod_Presentation)"
            key="SOFTWARE\Wow6432Node\nuipona\LinuxSCP 2">
      <parentCategory ref="LinuxSCP_Defaults" />
      <supportedOn ref="LinuxSCP_Supported_Windows10Plus" />
      <elements>
        <decimal id="UpdatePeriodDays"
                 valueName="DefaultUpdatesPeriod"
                 required="true"
                 minValue="0"
                 maxValue="365" />
      </elements>
    </policy>

    <policy name="LinuxSCP_DefaultCollectUsage"
            class="Machine"
            displayName="$(string.LinuxSCP_DefaultCollectUsage)"
            explainText="$(string.LinuxSCP_DefaultCollectUsage_Help)"
            key="SOFTWARE\Wow6432Node\nuipona\LinuxSCP 2"
            valueName="DefaultCollectUsage">
      <parentCategory ref="LinuxSCP_Defaults" />
      <supportedOn ref="LinuxSCP_Supported_Windows10Plus" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
  </policies>
</policyDefinitions>
