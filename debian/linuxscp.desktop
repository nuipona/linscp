[Desktop Entry]
Version=1.0
Type=Application
Name=LinSCP
GenericName=Secure File Transfer Client
Comment=Dual-Pane File Transfer Client with SFTP, FTP, WebDAV and S3
Exec=linuxscp-gui %u
Icon=linuxscp
Terminal=false
Categories=Network;FileTransfer;
Keywords=sftp;ftp;ftps;webdav;s3;scp;winscp;commander;
MimeType=x-scheme-handler/sftp;x-scheme-handler/ftp;x-scheme-handler/ftps;
StartupNotify=true
